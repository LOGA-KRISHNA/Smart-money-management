rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.memberIds;
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isRoomAdmin(roomId) {
      return signedIn() && roomData(roomId).createdBy == request.auth.uid;
    }

    function isJoiningSelf() {
      return signedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds", "updatedAt"]);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create, update: if isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
    }

    match /rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.createdBy == resource.data.createdBy
          || isJoiningSelf()
        );
      allow delete: if isRoomAdmin(roomId);
    }

    match /roomMembers/{memberId} {
      allow read: if signedIn() && isRoomMember(resource.data.roomId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "active"
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberIds.hasAny([request.auth.uid]);
      allow update: if signedIn()
        && (request.auth.uid == resource.data.userId || isRoomAdmin(resource.data.roomId));
      allow delete: if isRoomAdmin(resource.data.roomId);
    }

    match /tags/{tagId} {
      allow read: if isRoomMember(resource.data.roomId);
      allow create: if signedIn()
        && isRoomMember(request.resource.data.roomId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isRoomAdmin(resource.data.roomId));
    }

    match /expenses/{expenseId} {
      allow read: if isRoomMember(resource.data.roomId);
      allow create: if signedIn()
        && isRoomMember(request.resource.data.roomId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount > 0;
      allow update, delete: if signedIn()
        && isRoomMember(resource.data.roomId)
        && (resource.data.createdBy == request.auth.uid || isRoomAdmin(resource.data.roomId));
    }

    match /settlements/{settlementId} {
      allow read: if isRoomMember(resource.data.roomId);
      allow create: if signedIn()
        && isRoomMember(request.resource.data.roomId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount > 0;
      allow update, delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isRoomAdmin(resource.data.roomId));
    }
  }
}
